# ============================================
# 企业微信平台配置 (configs/workwechat.env)
# ============================================

# 企业微信 自建应用 凭证
# 获取: https://work.weixin.qq.com → 管理后台 → 应用管理 → 自建 → 创建应用
#       CorpID 在「我的企业 → 企业信息」；AgentId / Secret 在应用详情页
WORKWECHAT_CORP_ID=ww_your-corp-id
WORKWECHAT_AGENT_ID=1000002
WORKWECHAT_SECRET=your-app-secret

# 回调配置（企业微信 → 应用 → 接收消息 → 设置 API 接收）
# URL 填: https://你的域名/api/workwechat/callback
# Token 与 EncodingAESKey 在此页生成/填写，需与下方一致
WORKWECHAT_TOKEN=your-callback-token
WORKWECHAT_AES_KEY=your-43-char-encoding-aes-key

# 目标监控群 ChatId（可多个，用逗号分隔；留空 = 全部）
# 群机器人场景在消息 XML 中带 ChatId 字段
WORKWECHAT_CHAT_IDS=wr_xxxxx1,wr_xxxxx2

# 启用开关: true / false
WORKWECHAT_ENABLED=true
