# ============================================
# 应用通用配置 (configs/app.env)
# ============================================

# Web 服务
WEB_HOST=127.0.0.1
WEB_PORT=8001

# 管理员账号（部署后必须修改！）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_PASSWORD_SALT=

# 密钥（用于 JWT 签名，部署后改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-secret

# AI 模型（千问 AI 平台 · OpenAI 兼容接口）
AI_API_KEY=your-qianwen-maas-api-key
AI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
AI_MODEL=deepseek-v4.1-flash-1017
# 图片识别模型：默认与文本模型统一。
# 若该模型不支持图像输入（调用返回 400 / 提示 image_url 不受支持），
# 可在此单独覆盖为任意多模态模型（如 qwen-vl-plus），代码无需改动。
AI_MODEL_VISION=deepseek-v4.1-flash-1017
# 百炼专有参数（思考模式）；第三方兼容平台通常不支持，保持 false
AI_ENABLE_THINKING=false

# 安全配置
# 是否开放注册（默认关闭；内网/受控环境可改 true，或设置邀请码）
REGISTER_OPEN=false
# 邀请码（非空则注册时必须填写）
REGISTER_INVITE_CODE=
# HTTPS 部署时改为 true（Cookie 加 Secure 标志）
COOKIE_SECURE=false

# 每日报告时间（24小时制）
REPORT_HOUR=18
REPORT_MINUTE=0

# 平台消息轮询间隔（秒，钉钉拉取用）
POLL_INTERVAL=90

# 命令轮询间隔（秒，worker 消费 UI 命令）
COMMAND_INTERVAL=3

# 可选：Server酱推送（留空关闭） https://sct.ftqq.com/
SERVERCHAN_KEY=
