# ============================================
# 钉钉平台配置 (configs/dingtalk.env)
# ============================================

# 钉钉开放平台 企业内部应用 凭证
# 获取: https://open.dingtalk.com → 应用开发 → 企业内部开发 → 创建应用 → 凭证与基础信息
DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret

# 目标监控群 chatId（可多个，用逗号分隔）
# 获取方式见 README（需群主/管理员授权 qyapi_chat_read 权限）
DINGTALK_CHAT_IDS=chatxxxxx1,chatxxxxx2

# 启用开关: true / false
DINGTALK_ENABLED=true
