# ============================================
# QQ 开放平台配置 (configs/qq.env)
# ============================================

# QQ 开放平台机器人凭证
# 获取: https://q.qq.com / bot.q.qq.com → 创建机器人 → AppID / AppSecret
QQ_APP_ID=your-qq-app-id
QQ_APP_SECRET=your-qq-app-secret

# 沙箱/正式环境: sandbox / prod
# 沙箱: wss://sandbox.api.sgroup.qq.com/websocket/  正式: wss://api.sgroup.qq.com/websocket/
QQ_ENV=prod

# 目标监控群 openid（可多个，用逗号分隔）
# 群 openid 可从机器人收到的 GROUP_MESSAGE_CREATE 事件中获取，或按 README 指引
QQ_GROUP_OPENIDS=

# 启用开关: true / false
QQ_ENABLED=true
