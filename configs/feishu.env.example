# ============================================
# 飞书平台配置 (configs/feishu.env)
# ============================================

# 飞书开放平台 自建应用 凭证
# 获取: https://open.feishu.cn → 开发者后台 → 创建企业自建应用 → 凭证与基础信息
FEISHU_APP_ID=cli_your-app-id
FEISHU_APP_SECRET=your-app-secret

# 目标监控群 chat_id（可多个，用逗号分隔；留空 = 全部群）
# 需在应用权限中开通: im:message（接收消息）、im:message.group_at_msg:readonly 等
# 并在「事件订阅」中选择「长连接」模式，订阅 im.message.receive_v1
FEISHU_CHAT_IDS=oc_xxxxx1,oc_xxxxx2

# 启用开关: true / false
FEISHU_ENABLED=true
