<Slide style={{ background: '#FFFFFF', padding: '0px', position: 'relative', width: '100%', height: '100%' }}>
    {/* 顶部深蓝条 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    {/* 左侧标题栏 */}
    <Box style={{
        position: 'absolute', left: 0, top: 0,
        width: 300, height: 720,
        background: '#0E3F8C',
        justifyContent: 'center',
        flexDirection: 'column', padding: '0 40px', gap: 16,
    }}>
        <Text style={{ fontSize: 14, color: '#3D7BD9', letterSpacing: 2 }}>PART 02 · 安全设计</Text>
        <Text style={{ fontSize: 34, color: '#FFFFFF', fontWeight: 'bold', lineHeight: 1.4 }}>
            多用户认证
            <br />
            与安全加固
        </Text>
        <Box style={{ width: 48, height: 3, background: '#3D7BD9', marginTop: 4 }} />
    </Box>

    {/* 右侧内容区 */}
    <Box style={{
        position: 'absolute', left: 340, top: 0,
        width: 900, height: 720,
        padding: '56px 52px',
        flexDirection: 'column', justifyContent: 'center', gap: 24,
    }}>
        {/* 认证体系 */}
        <Box style={{ flexDirection: 'column', gap: 12 }}>
            <Text style={{ fontSize: 22, color: '#0E3F8C', fontWeight: 'bold' }}>🔐 多用户认证与权限分级</Text>
            <Box style={{ flexDirection: 'row', gap: 16 }}>
                <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 10, padding: '16px 20px' }}>
                    <Text style={{ fontSize: 15, color: '#1A2230', fontWeight: 'bold' }}>PBKDF2 + 随机盐</Text>
                    <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 4 }}>密码安全哈希存储，不存明文</Text>
                </Box>
                <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 10, padding: '16px 20px' }}>
                    <Text style={{ fontSize: 15, color: '#1A2230', fontWeight: 'bold' }}>JWT 令牌 + 密码版本号</Text>
                    <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 4 }}>改密/删号后旧令牌立即失效</Text>
                </Box>
                <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 10, padding: '16px 20px' }}>
                    <Text style={{ fontSize: 15, color: '#1A2230', fontWeight: 'bold' }}>多租户隔离</Text>
                    <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 4 }}>每账号独立绑定/数据/媒体，操作仅限自己实例</Text>
                </Box>
            </Box>
        </Box>

        {/* 安全加固清单 */}
        <Box style={{ flexDirection: 'column', gap: 12 }}>
            <Text style={{ fontSize: 22, color: '#0E3F8C', fontWeight: 'bold' }}>🛡 安全加固（10 项）</Text>
            <Box style={{ flexDirection: 'row', gap: 16, flexWrap: 'wrap' }}>
                {[
                    ['登录限流', '5 次失败锁 10 分钟'],
                    ['注册限频', '同 IP 10 分钟 5 次'],
                    ['IP 取信加固', '防伪造 XFF 绕过'],
                    ['CSRF 防护', '跨站 POST 拒绝'],
                    ['XSS 防护', '前后端全转义 + CSP'],
                    ['路径穿越防护', '文件读取双重校验'],
                    ['配置注入拦截', '.env 值清洗换行'],
                    ['JWT 密钥自动加固', '默认值自动随机化'],
                    ['审计日志', '登录/越权/管理留痕'],
                    ['接口脱敏', '密钥不回显明文'],
                ].map(([k, v], i) => (
                    <Box key={i} style={{
                        width: 248, background: '#F7F9FC', borderRadius: 8,
                        padding: '12px 16px',
                        flexDirection: 'row', gap: 10, alignItems: 'center',
                        border: '1px solid #E5E7EB',
                    }}>
                        <FAIcon name='shield' style={{ fill: '#1E4FA8', width: 18, height: 18 }} />
                        <Box>
                            <Text style={{ fontSize: 14, color: '#1A2230', fontWeight: 'bold' }}>{k}</Text>
                            <Text style={{ fontSize: 12, color: '#8B97A8' }}>{v}</Text>
                        </Box>
                    </Box>
                ))}
            </Box>
        </Box>

        <Box style={{
            background: '#F0F5FC', borderRadius: 10, padding: '16px 22px',
            borderLeft: '4px solid #1E4FA8',
        }}>
            <Text style={{ fontSize: 15, color: '#0E3F8C', fontWeight: 'bold', lineHeight: 1.6 }}>
                满足公网部署的安全基线：防爆破 · 防注入 · 防越权 · 全程审计
            </Text>
        </Box>
    </Box>

    {/* 页码 */}
    <Text style={{ position: 'absolute', right: 60, bottom: 40, fontSize: 14, color: '#8B97A8' }}>
        10 / 14
    </Text>
</Slide>
