<Slide style={{ background: '#FFFFFF', padding: '0px', position: 'relative', width: '100%', height: '100%' }}>
    {/* 顶部深蓝条 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    {/* 标题区 */}
    <Box style={{
        position: 'absolute', left: 60, top: 40,
        width: 1160,
        flexDirection: 'column',
    }}>
        <Text style={{ fontSize: 14, color: '#3D7BD9', letterSpacing: 2 }}>PART 02 · 系统设计</Text>
        <Text style={{ fontSize: 32, color: '#0E3F8C', fontWeight: 'bold', marginTop: 6 }}>
            系统总体架构 · 四进程分层
        </Text>
    </Box>

    {/* 架构 SVG（左 60%） */}
    <Box style={{
        position: 'absolute', left: 60, top: 130,
        width: 700, height: 480,
    }}>
        <svg width={700} height={480} viewBox='0 0 700 480'>
            {/* 背景 */}
            <rect x='0' y='0' width='700' height='480' rx='12' fill='#F7F9FC' />
            {/* 数据源层 */}
            <rect x='20' y='20' width='660' height='110' rx='10' fill='#E8EFF8' />
            <text x='40' y='50' font-size='16' font-weight='bold' fill='#0E3F8C'>数据源层</text>
            <rect x='40' y='62' width='190' height='52' rx='8' fill='#FFFFFF' stroke='#3D7BD9' stroke-width='1.5' />
            <text x='135' y='88' font-size='14' fill='#1A2230' text-anchor='middle'>QQ 官方机器人</text>
            <text x='135' y='106' font-size='12' fill='#8B97A8' text-anchor='middle'>WebSocket 长连接</text>
            <rect x='250' y='62' width='190' height='52' rx='8' fill='#FFFFFF' stroke='#3D7BD9' stroke-width='1.5' />
            <text x='345' y='88' font-size='14' fill='#1A2230' text-anchor='middle'>钉钉开放平台</text>
            <text x='345' y='106' font-size='12' fill='#8B97A8' text-anchor='middle'>API 轮询拉取</text>
            <rect x='460' y='62' width='200' height='52' rx='8' fill='#FFFFFF' stroke='#3D7BD9' stroke-width='1.5' />
            <text x='560' y='88' font-size='14' fill='#1A2230' text-anchor='middle'>阿里云百炼 AI</text>
            <text x='560' y='106' font-size='12' fill='#8B97A8' text-anchor='middle'>文本/视觉/语音模型</text>

            {/* 箭头 */}
            <path d='M 350 130 L 350 155' stroke='#1E4FA8' stroke-width='2' />
            <polygon points='345,152 355,152 350,160' fill='#1E4FA8' />

            {/* 核心处理层 */}
            <rect x='20' y='160' width='660' height='140' rx='10' fill='#F0F5FC' stroke='#1E4FA8' stroke-width='1.5' />
            <text x='40' y='190' font-size='16' font-weight='bold' fill='#0E3F8C'>核心处理层（独立 worker 进程 × 2）</text>
            <rect x='40' y='205' width='300' height='80' rx='8' fill='#FFFFFF' stroke='#1E4FA8' stroke-width='1.5' />
            <text x='190' y='228' font-size='14' font-weight='bold' fill='#1A2230' text-anchor='middle'>平台适配器（QQ / 钉钉）</text>
            <text x='190' y='250' font-size='12' fill='#4A5568' text-anchor='middle'>消息解析 · 媒体下载 · 语音转写</text>
            <text x='190' y='270' font-size='12' fill='#4A5568' text-anchor='middle'>断线重连 · 崩溃自愈</text>
            <rect x='360' y='205' width='300' height='80' rx='8' fill='#FFFFFF' stroke='#1E4FA8' stroke-width='1.5' />
            <text x='510' y='228' font-size='14' font-weight='bold' fill='#1A2230' text-anchor='middle'>消息流水线（Pipeline）</text>
            <text x='510' y='250' font-size='12' fill='#4A5568' text-anchor='middle'>去重入库 → 关键词匹配 → AI 判定</text>
            <text x='510' y='270' font-size='12' fill='#4A5568' text-anchor='middle'>提醒生成 · 报告生成 · 文件归档</text>

            {/* 箭头 */}
            <path d='M 350 300 L 350 325' stroke='#1E4FA8' stroke-width='2' />
            <polygon points='345,322 355,322 350,330' fill='#1E4FA8' />

            {/* 服务展示层 */}
            <rect x='20' y='330' width='660' height='110' rx='10' fill='#E8EFF8' />
            <text x='40' y='360' font-size='16' font-weight='bold' fill='#0E3F8C'>服务展示层（Web 进程）</text>
            <rect x='40' y='372' width='190' height='52' rx='8' fill='#FFFFFF' stroke='#3D7BD9' stroke-width='1.5' />
            <text x='135' y='396' font-size='14' fill='#1A2230' text-anchor='middle'>FastAPI Web</text>
            <text x='135' y='414' font-size='12' fill='#8B97A8' text-anchor='middle'>多用户 · 角色权限</text>
            <rect x='250' y='372' width='190' height='52' rx='8' fill='#FFFFFF' stroke='#3D7BD9' stroke-width='1.5' />
            <text x='345' y='396' font-size='14' fill='#1A2230' text-anchor='middle'>SSE 实时推送</text>
            <text x='345' y='414' font-size='12' fill='#8B97A8' text-anchor='middle'>毫秒级到达</text>
            <rect x='460' y='372' width='200' height='52' rx='8' fill='#FFFFFF' stroke='#3D7BD9' stroke-width='1.5' />
            <text x='560' y='396' font-size='14' fill='#1A2230' text-anchor='middle'>单页仪表盘</text>
            <text x='560' y='414' font-size='12' fill='#8B97A8' text-anchor='middle'>总览/消息/提醒/报告/文件</text>
        </svg>
    </Box>

    {/* 右侧要点（40%） */}
    <Box style={{
        position: 'absolute', left: 800, top: 150,
        width: 420, height: 460,
        flexDirection: 'column', gap: 22,
    }}>
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
            <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                <FAIcon name='server' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
            </Box>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold' }}>进程隔离</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 4, lineHeight: 1.6 }}>
                    Web / QQ / 钉钉 三进程独立，互不干扰，单点故障不影响全局
                </Text>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
            <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                <FAIcon name='database' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
            </Box>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold' }}>数据独立</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 4, lineHeight: 1.6 }}>
                    每平台独立 SQLite 库，消息 / 提醒 / 报告 / 文件统一管理
                </Text>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
            <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                <FAIcon name='envelope' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
            </Box>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold' }}>解耦通信</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 4, lineHeight: 1.6 }}>
                    Web → worker 通过命令文件通道下发控制指令，架构简单可靠
                </Text>
            </Box>
        </Box>
        <Box style={{
            background: '#F0F5FC', borderRadius: 10, padding: '16px 20px',
            borderLeft: '4px solid #1E4FA8', marginTop: 8,
        }}>
            <Text style={{ fontSize: 15, color: '#0E3F8C', fontWeight: 'bold', lineHeight: 1.6 }}>
                技术栈：Python · FastAPI · SQLite · SSE · 阿里云百炼大模型
            </Text>
        </Box>
    </Box>

    {/* 页码 */}
    <Text style={{ position: 'absolute', right: 60, bottom: 40, fontSize: 14, color: '#8B97A8' }}>
        5 / 14
    </Text>
</Slide>
