<Slide style={{ background: '#FFFFFF', padding: '0px', position: 'relative', width: '100%', height: '100%' }}>
    {/* 顶部深蓝条 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    {/* 标题区 */}
    <Box style={{ position: 'absolute', left: 60, top: 40, width: 1160, flexDirection: 'column' }}>
        <Text style={{ fontSize: 14, color: '#3D7BD9', letterSpacing: 2 }}>PART 02 · 核心技术 3</Text>
        <Text style={{ fontSize: 32, color: '#0E3F8C', fontWeight: 'bold', marginTop: 6 }}>
            文件库 · 图片 / 文件 / 语音自动保存与 AI 识别
        </Text>
    </Box>

    {/* 左：三路识别 SVG */}
    <Box style={{ position: 'absolute', left: 60, top: 130, width: 560, height: 500 }}>
        <svg width={560} height={500} viewBox='0 0 560 500'>
            <rect x='0' y='0' width='560' height='500' rx='12' fill='#F7F9FC' />

            {/* 中间汇聚节点 */}
            <rect x='180' y='210' width='200' height='80' rx='12' fill='#0E3F8C' />
            <text x='280' y='244' font-size='15' font-weight='bold' fill='#FFFFFF' text-anchor='middle'>统一 files 表</text>
            <text x='280' y='270' font-size='12' fill='#B8CCF0' text-anchor='middle'>元数据 + AI 描述 + 分类</text>

            {/* 图片分支 */}
            <path d='M 150 130 C 150 170, 190 190, 230 210' stroke='#1E4FA8' stroke-width='2' fill='none' />
            <rect x='30' y='30' width='240' height='100' rx='10' fill='#FFFFFF' stroke='#3D7BD9' stroke-width='1.5' />
            <text x='150' y='58' font-size='14' font-weight='bold' fill='#0E3F8C' text-anchor='middle'>🖼 图片</text>
            <text x='150' y='84' font-size='12' fill='#4A5568' text-anchor='middle'>qwen-vl-plus 视觉模型</text>
            <text x='150' y='108' font-size='12' fill='#4A5568' text-anchor='middle'>识别内容 · 判断是否重要资料</text>

            {/* 文件分支 */}
            <path d='M 280 130 C 280 170, 280 180, 280 210' stroke='#1E4FA8' stroke-width='2' fill='none' />
            <rect x='160' y='30' width='240' height='100' rx='10' fill='#FFFFFF' stroke='#3D7BD9' stroke-width='1.5' />
            <text x='280' y='58' font-size='14' font-weight='bold' fill='#0E3F8C' text-anchor='middle'>📄 文件</text>
            <text x='280' y='84' font-size='12' fill='#4A5568' text-anchor='middle'>文件名 + 类型智能分类</text>
            <text x='280' y='108' font-size='12' fill='#4A5568' text-anchor='middle'>文档/表格/课件/压缩包</text>

            {/* 语音分支 */}
            <path d='M 410 130 C 410 170, 370 190, 330 210' stroke='#1E4FA8' stroke-width='2' fill='none' />
            <rect x='290' y='30' width='240' height='100' rx='10' fill='#FFFFFF' stroke='#3D7BD9' stroke-width='1.5' />
            <text x='410' y='58' font-size='14' font-weight='bold' fill='#0E3F8C' text-anchor='middle'>🎤 语音</text>
            <text x='410' y='84' font-size='12' fill='#4A5568' text-anchor='middle'>ASR 语音转写文本</text>
            <text x='410' y='108' font-size='12' fill='#4A5568' text-anchor='middle'>QQ 官方转写 / 百炼 paraformer</text>

            {/* 下方结果 */}
            <path d='M 280 290 L 280 320' stroke='#1E4FA8' stroke-width='2' />
            <polygon points='275,317 285,317 280,325' fill='#1E4FA8' />
            <rect x='80' y='330' width='400' height='140' rx='10' fill='#F0F5FC' stroke='#1E4FA8' stroke-width='1.5' />
            <text x='280' y='360' font-size='14' font-weight='bold' fill='#0E3F8C' text-anchor='middle'>AI 自动整理归档</text>
            <text x='280' y='390' font-size='13' fill='#1A2230' text-anchor='middle'>重要文件 → 标记 ★ 并生成提醒</text>
            <text x='280' y='414' font-size='13' fill='#1A2230' text-anchor='middle'>文件库页：缩略图 / 预览 / 下载 / 筛选</text>
            <text x='280' y='438' font-size='13' fill='#1A2230' text-anchor='middle'>按平台 / 分类 / 重要状态搜索</text>
        </svg>
    </Box>

    {/* 右：说明 */}
    <Box style={{
        position: 'absolute', left: 660, top: 150,
        width: 560, height: 460,
        flexDirection: 'column', gap: 20,
    }}>
        <Box style={{
            background: '#F0F5FC', borderRadius: 10, padding: '18px 22px',
            borderLeft: '4px solid #1E4FA8',
        }}>
            <Text style={{ fontSize: 16, color: '#0E3F8C', fontWeight: 'bold', lineHeight: 1.6 }}>
                群里的每个附件都不再"一闪而过"，而是沉淀为可检索的班级资料库
            </Text>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 14 }}>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <FAIcon name='download' style={{ fill: '#1E4FA8', width: 20, height: 20, marginTop: 3 }} />
                <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.6 }}>
                    附件自动下载保存到 <span style={{ fontWeight: 'bold' }}>data/media/</span>（按平台/日期归档）
                </Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <FAIcon name='brain' style={{ fill: '#1E4FA8', width: 20, height: 20, marginTop: 3 }} />
                <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.6 }}>
                    <span style={{ fontWeight: 'bold' }}>三路 AI 识别</span>：视觉模型看图、文本模型分类文件、ASR 转写语音
                </Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <FAIcon name='star' style={{ fill: '#FFC107', width: 20, height: 20, marginTop: 3 }} />
                <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.6 }}>
                    重要资料自动<span style={{ fontWeight: 'bold', color: '#D9534F' }}>标 ★</span> 并生成提醒，管理员可手动更正
                </Text>
            </Box>
        </Box>
        <Box style={{
            background: '#E8EFF8', borderRadius: 10, padding: '16px 20px', marginTop: 8,
        }}>
            <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.7 }}>
                <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>双平台同步</span>：QQ 与钉钉的图片/文件/语音
                走同一套保存与识别管线，能力完全对齐。
            </Text>
        </Box>
    </Box>

    {/* 页码 */}
    <Text style={{ position: 'absolute', right: 60, bottom: 40, fontSize: 14, color: '#8B97A8' }}>
        9 / 14
    </Text>
</Slide>
