<Slide style={{ background: '#FFFFFF', padding: '0px', position: 'relative', width: '100%', height: '100%' }}>
    {/* 左侧深蓝主视觉带 */}
    <Box style={{
        position: 'absolute', left: 0, top: 0,
        width: 420, height: 720,
        background: 'linear-gradient(160deg, #0E3F8C 0%, #1E4FA8 60%, #3D7BD9 100%)',
        justifyContent: 'center', alignItems: 'center',
        flexDirection: 'column', gap: 12, padding: 40,
    }}>
        <FAIcon name='comments' style={{ fill: '#FFFFFF', width: 72, height: 72, opacity: 0.95 }} />
        <Text style={{ fontSize: 20, color: '#FFFFFF', opacity: 0.85, letterSpacing: 4 }}>
            群聊信息智能监控与分析系统
        </Text>
        <Box style={{ width: 120, height: 2, background: '#FFFFFF', opacity: 0.5, marginTop: 8 }} />
        <Text style={{ fontSize: 15, color: '#FFFFFF', opacity: 0.7, marginTop: 16 }}>
            科创比赛参赛作品
        </Text>
    </Box>

    {/* 右侧标题区 */}
    <Box style={{
        position: 'absolute', left: 420, top: 0,
        width: 860, height: 720,
        padding: '0 80px',
        justifyContent: 'center',
        flexDirection: 'column',
    }}>
        <Text style={{ fontSize: 24, color: '#1E4FA8', fontWeight: 'bold', letterSpacing: 2, marginBottom: 12 }}>
            ChatMonitor
        </Text>
        <Text style={{ fontSize: 52, color: '#0E3F8C', fontWeight: 'bold', lineHeight: 1.3, marginBottom: 20 }}>
            聊天智能分析助手
        </Text>
        <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.7, marginBottom: 44 }}>
            面向校园班级与社群的 QQ / 钉钉群聊
            <br />
            重要信息识别 · 实时提醒 · 自动归档
        </Text>
        <Box style={{ flexDirection: 'row', gap: 16, marginBottom: 60 }}>
            <Box style={{ background: '#E8EFF8', borderRadius: 20, padding: '8px 20px' }}>
                <Text style={{ fontSize: 15, color: '#1E4FA8' }}>多平台接入</Text>
            </Box>
            <Box style={{ background: '#E8EFF8', borderRadius: 20, padding: '8px 20px' }}>
                <Text style={{ fontSize: 15, color: '#1E4FA8' }}>AI 智能判定</Text>
            </Box>
            <Box style={{ background: '#E8EFF8', borderRadius: 20, padding: '8px 20px' }}>
                <Text style={{ fontSize: 15, color: '#1E4FA8' }}>毫秒级推送</Text>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 40 }}>
            <Text style={{ fontSize: 15, color: '#8B97A8' }}>参赛者：笺</Text>
            <Text style={{ fontSize: 15, color: '#8B97A8' }}>2026 年 8 月</Text>
        </Box>
    </Box>
</Slide>
